# Variablat e mjedisit për Netlify (Site configuration → Environment variables). MOS i futni vlerat reale në git.
ADMIN_PASSWORD=vendosni-një-fjalëkalim-të-gjatë-dhe-unik     # DETYRUESHME: hyrja te /admin/garancia/
TOKEN_SECRET=vendosni-një-varg-të-rastësishëm-32+-karaktere  # rekomandohet (mund ta gjeneroni me: openssl rand -hex 32)
SITE_URL=https://www.apexframes.co                           # opsionale (parazgjedhja është kjo)
ADMIN_NOTIFY_EMAIL=info@apexframes.co                        # opsionale: ku vjen njoftimi për kërkesë të re

# Email automatik (opsional; pa këto sistemi punon njësoj, vetëm nuk dërgon email):
RESEND_API_KEY=
MAIL_FROM=Apex Frames <info@apexframes.co>
